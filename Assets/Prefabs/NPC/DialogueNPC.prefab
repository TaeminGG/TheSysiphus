  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNPC
  hitLayer:
    serializedVersion: 2
    m_Bits: 64
  interactionCanvas: {fileID: 2637898487112438048}
  floorZ: 0
  interactionPriority: 15
  dialogueUI: {fileID: 542818936220916597}
  dialogueDuration: 2.5
  firstEncounterLines:
  - "\uC5EC\uAE30\uC11C \uD0C8\uCD9C\uD558\uACA0\uB2E4\uACE0?"
  - "\uB300\uAE30\uC7A5\uC18C\uC5D0\uC11C\uB294 \uC228\uC744 \uACE0\uB974\uB294 \uAC83\uB3C4
    \uC2E4\uB825\uC774\uC9C0."
  - "\uC900\uBE44\uAC00 \uB05D\uB098\uBA74 \uB2E4\uC2DC \uB9D0\uC744 \uAC78\uC5B4\uB77C."
  repeatLines:
  - "F\uD0A4\uB97C \uC774\uC6A9\uD574 \uB0B4\uAC00 \uC900 \uC774\uCF54\uB974\uBCD1\uC744
    \uC0AC\uC6A9\uD558\uBA74 \uCCB4\uB825\uC744 \uD68C\uBCF5\uD560 \uC218 \uC788\uC744\uAC70\uB2E4."
  - "\uB3C4\uC911\uC5D0 \uB2A5\uB825\uC774 \uC11C\uB9B0 \uC544\uC774\uD15C\uC744
    \uBC1C\uACAC\uD55C\uB2E4\uBA74 Q\uD0A4\uB97C \uC774\uC6A9\uD574 \uC0AC\uC6A9\uD560
    \uC218 \uC788\uC744\uAC70\uB2E4."
  - "\uAE38\uC744 \uB530\uB77C \uC544\uB798\uB85C \uB0B4\uB824\uAC00. \uC9C0\uC625\uC758
    \uBD88\uAE38\uC740 \uB0B4\uAC00 \uCD5C\uB300\uD55C \uB9C9\uC544\uBCF4\uC9C0."
